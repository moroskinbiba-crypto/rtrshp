{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/retrotorrent/catalog/source-registry-v1.schema.json",
  "title": "RetroTorrent Source Registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "primary_source",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "primary_source": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "priority",
          "enabled",
          "homepage",
          "import_methods",
          "automated_indexing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "external_tracker",
              "catalog_api",
              "local_folder"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "enabled": {
            "type": "boolean"
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "topic_url_prefix": {
            "type": "string",
            "format": "uri"
          },
          "import_methods": {
            "type": "array",
            "items": {
              "enum": [
                "save_topic_reference",
                "import_torrent_file",
                "import_magnet_uri"
              ]
            }
          },
          "automated_indexing": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
