{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/retrotorrent/catalog/rutracker-filters-v1.schema.json",
  "title": "RetroTorrent RuTracker Filter Set v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "search",
    "policy",
    "query_rule",
    "systems"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "const": "rutracker"
    },
    "search": {
      "type": "object",
      "required": [
        "endpoint",
        "forum_ids",
        "forum_title",
        "forum_source_url",
        "query_parameter",
        "forum_parameter"
      ],
      "properties": {
        "endpoint": {
          "const": "https://rutracker.org/forum/tracker.php"
        },
        "forum_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "forum_title": {
          "const": "Игры для консолей"
        },
        "forum_source_url": {
          "type": "string",
          "format": "uri"
        },
        "query_parameter": {
          "const": "nm"
        },
        "forum_parameter": {
          "const": "f[]"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "manual_topic_selection_required",
        "automated_indexing",
        "allowed_release_terms",
        "rights_review_required",
        "note"
      ],
      "properties": {
        "manual_topic_selection_required": {
          "const": true
        },
        "automated_indexing": {
          "const": false
        },
        "allowed_release_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "rights_review_required": {
          "const": true
        },
        "note": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "query_rule": {
      "type": "string",
      "minLength": 20
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "group",
          "search_terms"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "search_terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
